[sub_resource type="Shader" id="Vignette_shader"]
code = "shader_type canvas_item;

// Screen-space finishing pass: tilt-shift blur (top/bottom of screen, sampled from
// the screen texture's mip chain — far cheaper than the 3D DOF pass) + warm vignette.

uniform float vignette_strength = 0.22;
uniform vec3 tint = vec3(0.30, 0.24, 0.20);
uniform float focus_center = 0.52;   // screen-y of the sharp band
uniform float focus_half = 0.34;     // half-height of the sharp band
uniform float blur_ramp = 0.28;
uniform float max_lod = 0.7;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;

void fragment() {
	float off = abs(SCREEN_UV.y - focus_center);
	float lod = smoothstep(focus_half, focus_half + blur_ramp, off) * max_lod;
	vec3 col = textureLod(screen_tex, SCREEN_UV, lod).rgb;
	vec2 uv = SCREEN_UV - 0.5;
	uv.x *= SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
	float v = smoothstep(0.35, 0.95, length(uv) * 1.1);
	COLOR = vec4(mix(col, col * tint * 2.2, v * vignette_strength), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="Vignette_mat"]
