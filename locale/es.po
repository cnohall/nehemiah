msgstr "¡Etapa construida!"

msgid "Hands full — deliver it, or {drop} to drop"
msgstr "Manos llenas — entrégalo o {drop} para soltar"

msgid "Bring it to a wall"
msgstr "Lleva la carga a la muralla"

msgid "Needs {need} first"
msgstr "Primero necesita {need}"

msgid "Build this stage first — {drop} to drop, then {interact} to work"
msgstr "Primero construye esta etapa — {drop} para soltar la carga, luego {interact} para trabajar"

msgid "This wall is finished"
msgstr "Esta muralla está terminada"

msgid "Caught it"
msgstr "¡Atrapada!"

msgid "Heavy — a partner can take the other end {interact}"
msgstr "Pesa — un compañero puede tomar el otro extremo {interact}"

msgid "Enough hands here"
msgstr "Ya hay suficientes manos aquí"

msgid "The horn was just sounded"
msgstr "El cuerno acaba de sonar"

msgid "Going down to Ono…"
msgstr "Bajando a Ono…"

msgid "Why should the work stop? Back to the wall!"
msgstr "¿Por qué ha de detenerse la obra? ¡De vuelta a la muralla!"

msgid "Begin now"
msgstr "Empezar ya"

msgid "E · Click   Continue          Esc   Skip"
msgstr "E · Clic   Continuar          Esc   Saltar"

