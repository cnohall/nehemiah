msgstr "Tu oficio — manos más rápidas en esta obra"

msgid "Your trade — quicker with a load"
msgstr "Tu oficio — más rápido con carga"

msgid "Your trade — your blows land harder"
msgstr "Tu oficio — tus golpes pegan más fuerte"

