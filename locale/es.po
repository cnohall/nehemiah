msgid "“Remember me, my God, for good.”"
msgstr "“Acuérdate de mí, Dios mío, para bien.”"

msgid "Thank you for building with us."
msgstr "Gracias por construir con nosotros."

msgid "Hold E   Faster          Esc   Skip"
msgstr "Mantén E   Más rápido          Esc   Saltar"

