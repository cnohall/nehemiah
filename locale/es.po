msgid_plural "Raise the whole stretch — %d days before the stars"
msgstr[0] "Levanten todo el tramo — %d día antes de las estrellas"
msgstr[1] "Levanten todo el tramo — %d días antes de las estrellas"

msgid "Finished with %d day to spare"
msgid_plural "Finished with %d days to spare"
msgstr[0] "Terminado con %d día de sobra"
msgstr[1] "Terminado con %d días de sobra"

