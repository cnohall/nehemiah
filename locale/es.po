msgstr "Dificultad: %s"

msgid "Gentle"
msgstr "Suave"

msgid "Standard"
msgstr "Normal"

msgid "Hard"
msgstr "Difícil"

msgid "Fewer enemies, lighter blows"
msgstr "Menos enemigos, golpes más leves"

msgid "The wall as it was built"
msgstr "El muro como se construyó"

msgid "More enemies, heavier blows"
msgstr "Más enemigos, golpes más fuertes"

