msgid_plural "%d got through"
msgstr[0] "pasó %d"
msgstr[1] "pasaron %d"

msgid "%d load"
msgid_plural "%d loads"
msgstr[0] "%d carga"
msgstr[1] "%d cargas"

msgid "%d foe"
msgid_plural "%d foes"
