msgid "Saboteur — stop him before he strews the yard"
msgstr "Saboteur — halte ihn auf, bevor er den Lagerplatz verstreut"

msgid "Don't go with him — just walk away"
msgstr "Geh nicht mit ihm — geh einfach weg"

msgid "Watch the %s — %s"
msgstr "Schau dem %s zu — %s"

msgid "The %s pile was strewn — tidy it (%s at the pile)"
msgstr "Der %s-Haufen wurde verstreut — räum ihn auf (%s am Haufen)"

msgid "A new robe dye earned: %s — wear it from the menu"
