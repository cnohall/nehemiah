msgstr "뿔나팔 — 작업단 부르기"

msgid "Controller disconnected — reconnect it to carry on"
msgstr "컨트롤러 연결이 끊겼습니다 — 다시 연결하면 계속할 수 있습니다"

msgid "Invite friends"
msgstr "친구 초대"

msgid "Overlay off — use the Crew panel"
msgstr "오버레이 꺼짐 — 작업단 패널을 사용하세요"

msgid "or press %s to begin"
msgstr "또는 %s 눌러 시작"

msgid "Down — a crewmate can lift you, or wait it out"
msgstr "쓰러짐 — 동료가 일으켜 주거나 기다리세요"

msgid "The day's stretch is done — keep the wall"
msgstr "오늘 구간 완성 — 성벽을 지키세요"

msgid "Take the %s to the gate"
msgstr "%s → 성문으로 가져가세요"

msgid "Take the %s to the wall"
msgstr "%s → 성벽으로 가져가세요"

msgid "Nothing needs %s now — drop it (%s)"
msgstr "지금은 %s 필요 없음 — 내려놓기 (%s)"

msgid "Build it up — %s at the gate"
msgstr "건축하기 — 성문에서 %s"

msgid "Build it up — %s at the wall"
msgstr "건축하기 — 성벽에서 %s"

msgid "Next: bring %s to the gate"
msgstr "다음: %s → 성문"

msgid "Next: bring %s to the wall"
msgstr "다음: %s → 성벽"

