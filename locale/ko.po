msgstr "너무 많은 적이 도성 안까지 들어왔습니다. 일꾼들을 모아 다시 시작하세요."

msgid "Days built"
msgstr "건축한 날"

msgid "Sections"
msgstr "구간"

msgid "Breaches"
msgstr "침입"

msgid "Marks"
msgstr "휘장"

