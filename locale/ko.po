msgstr[0] "%d일 남김"

msgid "rebuilt what fell"
msgstr "무너진 곳을 다시 쌓음"

msgid "The sun is low!"
msgstr "해가 기울었습니다!"

msgid "from the west"
msgstr "서쪽에서"

