msgstr "%d/%d 구간  ·  %s"

msgid "The %s stands"
msgstr "%s 완공"

msgid "A new best for this stretch — %d of 3 marks."
msgstr "이 구간 최고 기록 — 휘장 3개 중 %d개."

msgid "%d of 3 marks. Your best here stays as it was."
msgstr "휘장 3개 중 %d개. 이 구간 최고 기록은 그대로입니다."

msgid "Too many enemies reached the inner city. Try the stretch again."
msgstr "너무 많은 적이 도성 안까지 들어왔습니다. 이 구간에 다시 도전하세요."

msgid "Back to the map"
msgstr "지도로 돌아가기"

msgid "Day %d complete"
msgstr "%d일차 완료"

msgid "Not one enemy got through."
msgstr "적이 한 명도 통과하지 못했습니다."

msgid "Section %d of %d complete  ·  %s"
msgstr "%d/%d 구간 완료  ·  %s"

msgid "Loads carried"
msgstr "나른 짐"

msgid "Foes felled"
msgstr "물리친 적"

