msgid "Raiders — quick ones, mind the gaps!"
msgstr "약탈자입니다 — 빠르니 틈을 지키세요!"

msgid "One got into the city!  %d of %d"
msgstr "한 명이 도성에 들어왔습니다!  %d/%d"

msgid "One got in — %d more and the city falls!"
msgid_plural "One got in — %d more and the city falls!"
msgstr[0] "한 명이 들어왔습니다 — %d명만 더 들어오면 도성이 무너집니다!"

msgid "Day info"
