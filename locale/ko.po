msgstr "%s 내려놓기 — 동료 곁에서는 그의 손으로 넘어갑니다"

msgid "A beam goes quicker with a partner on the other end"
msgstr "들보는 반대쪽 끝에 동료가 있으면 더 빨리 옮겨집니다"

msgid "[%s] Sling · up close it's the sword"
msgstr "[%s] 물매 · 가까이서는 검"

msgid "[%s] Sound the horn — the crew gathers to you"
msgstr "[%s] 뿔나팔 불기 — 작업단이 당신에게 모입니다"

msgid "%s Help up"
msgstr "%s 일으키기"

msgid "%s Take the other end"
msgstr "%s 반대쪽 끝 잡기"

msgid "%s beside them: hand over the %s"
msgstr "%s 곁에서: %s 건네기"

msgid "%s Take %s"
msgstr "%s %s 집기"

msgid "%s Pick up %s"
msgstr "%s %s 줍기"

msgid "%s Work it up"
msgstr "%s 쌓아 올리기"

msgid "%s Deliver the %s"
msgstr "%s %s 전달"

msgid "Watch post: bring %s"
msgstr "망대: %s 가져오기"

msgid "Bring %s"
msgstr "%s 가져오기"

msgid "%s Climb over"
msgstr "%s 넘어가기"

msgid "%s Tidy the strewn pile"
msgstr "%s 흩어진 더미 정리"

msgid "Saboteur — stop him before he strews the yard"
msgstr "방해꾼 — 자재터를 어지럽히기 전에 막으세요"

msgid "Don't go with him — just walk away"
msgstr "따라가지 말고 그냥 돌아서세요"

msgid "Watch the %s — %s"
msgstr "%s 지켜보기 — %s"

msgid "The %s pile was strewn — tidy it (%s at the pile)"
msgstr "%s 더미가 흩어졌습니다 — 정리하세요 (더미 앞에서 %s)"

msgid "A new robe dye earned: %s — wear it from the menu"
msgstr "새 옷 염료 획득: %s — 메뉴에서 입어 보세요"

msgid "%d of %d stretches stand  ·  %d days to the fifty-second"
msgstr "%d/%d 구간 완성  ·  쉰두째 날까지 %d일"

msgid "Robe: %s"
msgstr "옷: %s"

msgid "%s at %d marks (you have %d)"
msgstr "%s — 휘장 %d개 필요 (현재 %d개)"

msgid "Continue — %s, day %d"
msgstr "이어하기 — %s, %d일째"

msgid "One's slipped in — the yard! He's after the piles"
msgstr "하나가 숨어들었습니다 — 자재터예요! 더미를 노립니다"

msgid "At the gate! Torches!"
msgstr "성문으로! 횃불이다!"

msgid "Beams take two"
msgstr "들보는 둘이서"

msgid "Both ends at once — split up!"
msgstr "양쪽 끝에서 동시에 — 나뉘세요!"

msgid "Both ends — mind the lanes!"
msgstr "양쪽 끝이에요 — 골목을 지키세요!"

msgid "Brutes for the gate!"
msgstr "거한들이 성문으로!"

msgid "Brutes for the priests' houses!"
msgstr "거한들이 제사장들의 집으로!"

msgid "But now, strengthen my hands."
msgstr "이제 내 손을 힘 있게 하소서."

msgid "By the pool"
msgstr "못가에서"

msgid "Carry it together to the wall"
msgstr "함께 성벽까지 나르세요"

msgid "Carry the mortar to the wall"
msgstr "회반죽을 성벽까지 나르세요"

msgid "Dig the stone out of the rubble heaps"
msgstr "돌무더기에서 돌을 캐내세요"

msgid "Eliashib the high priest"
msgstr "대제사장 엘리아십"

msgid "Everyone gathers to the horn"
msgstr "모두가 뿔나팔 소리에 모입니다"

msgid "Everything they have — to the gate!"
msgstr "가진 모든 것을 던져 — 성문으로!"

msgid "Ezra the scribe"
msgstr "서기관 에스라"

msgid "Geshem's raiders, from the east!"
msgstr "게셈의 약탈자들이 동쪽에서!"

msgid "Go with him and you're led away from the work"
msgstr "따라가면 공사에서 멀어집니다"

msgid "Half its height! And they've heard of it…"
msgstr "절반 높이! 그들도 소문을 들었습니다…"

msgid "Hananiah the perfumer"
msgstr "향품 제조자 하나냐"

msgid "Hang the doors — the crew walks through, the foe can't"
msgstr "문짝을 다세요 — 작업단은 지나가고 적은 못 지나갑니다"

msgid "Hanun of Zanoah"
msgstr "사노아의 하눈"

msgid "Heaps outside the wall hold twice as much — if you dare"
msgstr "성벽 밖 더미에는 두 배가 있습니다 — 감히 나간다면요"

msgid "If a fox climbed up it, he would break down their stone wall."
msgstr "여우가 올라가도 그들의 돌 성벽은 무너지리라."

msgid "Ignore him — he gives up and leaves"
msgstr "무시하세요 — 그는 포기하고 떠납니다"

msgid "It mixes by itself — wait a moment"
msgstr "저절로 섞입니다 — 잠시 기다리세요"

msgid "It stands up to the brutes twice as long"
msgstr "거한들을 두 배 오래 버팁니다"

msgid "Joiada and Meshullam"
msgstr "요야다와 므술람"

msgid "Lime and water into the trough"
msgstr "석회와 물을 구유에"

msgid "Madder red"
msgstr "꼭두서니 붉은색"

msgid "Malchijah and Hasshub"
msgstr "말기야와 핫숩"

msgid "Malchijah son of Rechab"
msgstr "레갑의 아들 말기야"

msgid "Malchijah the goldsmith"
msgstr "금장색 말기야"

msgid "Meremoth the priest"
msgstr "제사장 므레못"

msgid "Mix the mortar"
msgstr "회반죽 이기기"

msgid "More stone to each piece, four hands at the work"
msgstr "조각마다 돌이 더 들고, 네 손이 함께 일합니다"

msgid "Narrow lanes — one at a time"
msgstr "좁은 골목 — 한 번에 한 명씩"

msgid "Nehemiah son of Azbuk"
msgstr "아스북의 아들 느헤미야"

msgid "Nehemiah the governor"
msgstr "총독 느헤미야"

msgid "New Game"
msgstr "새 게임"

msgid "Night falls on the work"
msgstr "공사 위에 밤이 내립니다"

msgid "No stone pile here"
msgstr "이곳에는 돌 더미가 없습니다"

msgid "North up"
msgstr "북쪽이 위"

msgid "Olive green"
msgstr "올리브 녹색"

msgid "Out of the dark — both ends!"
msgstr "어둠 속에서 — 양쪽 끝이에요!"

msgid "Pass loads over rather than queue"
msgstr "줄 서지 말고 짐을 넘겨 주세요"

msgid "Piles scattered"
msgstr "더미가 흩어짐"

msgid "Priests' houses between yard and wall"
msgstr "자재터와 성벽 사이의 제사장 집들"

msgid "Quiet in the valley today."
msgstr "오늘 골짜기는 조용합니다."

msgid "Quiet ones — after the yard!"
msgstr "조용한 자들이 자재터를 노립니다!"

msgid "Raiders on the haul road!"
msgstr "약탈자들이 운반로에!"

msgid "Raiders up both sides of the valley!"
msgstr "약탈자들이 골짜기 양쪽에서 올라옵니다!"

msgid "Raise both pillars of the gate"
msgstr "성문의 두 기둥을 세우세요"

msgid "Shallum's daughters"
msgstr "살룸의 딸들"

msgid "Shallun son of Colhozeh"
msgstr "골호세의 아들 살룬"

msgid "So we did the work. Half of the people held the spears from the rising of the morning until the stars appeared."
msgstr "이렇게 우리는 공사를 했습니다. 백성의 절반은 동틀 때부터 별이 나올 때까지 창을 들었습니다."

msgid "Sound the horn"
msgstr "뿔나팔 불기"

msgid "Stack loads on the relay mat halfway"
msgstr "중간의 이어받기 깔개에 짐을 쌓으세요"

msgid "Stone from the rubble"
msgstr "돌무더기의 돌"

msgid "Take the other end"
msgstr "반대쪽 끝 잡기"

msgid "The Broad Wall"
msgstr "넓은 성벽"

msgid "The God of heaven will prosper us. Therefore we, his servants, will arise and build"
msgstr "하늘의 하나님이 우리를 형통하게 하실 것이니, 그의 종들인 우리가 일어나 건축하리라"

msgid "The foe comes out of the dark"
msgstr "적이 어둠 속에서 나옵니다"

msgid "The gatekeeper"
msgstr "문지기"

msgid "The last of it — hold on!"
msgstr "마지막이에요 — 버티세요!"

msgid "The last stone — all of them at once!"
msgstr "마지막 돌 — 전부 한꺼번에!"

msgid "The long haul"
msgstr "먼 운반길"

msgid "The night watch"
msgstr "밤의 파수"

msgid "The pool is by the wall"
msgstr "못이 성벽 곁에 있습니다"

msgid "The priests' stretch is rising!"
msgstr "제사장들의 구간이 올라갑니다!"

msgid "The sons of Hassenaah"
msgstr "핫스나아의 자손들"

msgid "The temple servants of Ophel"
msgstr "오벨의 성전 일꾼들"

msgid "The yard is far from the wall"
msgstr "자재터가 성벽에서 멉니다"

msgid "Then bring timber to the gap"
msgstr "그다음 틈으로 목재를 나르세요"

msgid "They come up the valley in surges"
msgstr "그들은 파도처럼 골짜기를 올라옵니다"

msgid "They want the last gap!"
msgstr "마지막 틈을 노립니다!"

msgid "They will not know or see, until we come in among them and kill them, and cause the work to cease."
msgstr "우리가 그들 가운데 들어가 그들을 죽여 공사를 그치게 할 때까지 그들은 알지도 보지도 못하리라."

msgid "They'll try the gate before its doors hang!"
msgstr "문짝이 달리기 전에 성문을 노릴 겁니다!"

msgid "They're all coming!"
msgstr "모두 몰려옵니다!"

msgid "They're at the gate — hold it!"
msgstr "성문에 왔어요 — 지키세요!"

msgid "They've all come together!"
msgstr "모두 한데 모였습니다!"

msgid "Torches light the way — each worker has a lamp"
msgstr "횃불이 길을 밝힙니다 — 일꾼마다 등불이 있습니다"

msgid "Tyrian purple"
msgstr "두로 자주색"

msgid "Undyed linen"
msgstr "염색하지 않은 아마포"

msgid "Uzziel the goldsmith"
msgstr "금장색 웃시엘"

msgid "Wall across"
msgstr "성벽 가로"

msgid "Watch the carpenter — two to a beam"
msgstr "목수를 보세요 — 들보 하나에 둘이"

msgid "Water close at hand — mortar comes quickly"
msgstr "물이 가까워 — 회반죽이 금방 됩니다"

msgid "What are these feeble Jews doing?"
msgstr "이 힘없는 유다 사람들이 무엇을 하는 것이냐?"

msgid "What can I do here?"
msgstr "여기서 무엇을 할 수 있나요?"

msgid "Wherever you hear the sound of the trumpet, rally there to us. Our God will fight for us."
msgstr "나팔 소리가 들리는 곳으로 우리에게 모이라. 우리 하나님이 우리를 위해 싸우시리라."

msgid "Woad blue"
msgstr "대청 푸른색"

msgid "Before the work"
msgstr "일을 시작하기 전에"

msgid "How will you meet it?"
msgstr "어떻게 맞이할까요?"

msgid "The crew chose: %s"
msgstr "선택: %s"

msgid "Outer face"
msgstr "바깥 면"

msgid "Inner face"
msgstr "안쪽 면"

msgid "Clear the charred timbers"
msgstr "불탄 들보 치우기"

msgid "←  →   Choose          E · Click   Confirm"
msgstr "←  →   선택          E · 클릭   확인"

msgid "Old stones, burned timbers"
msgstr "오래된 돌, 불탄 들보"

msgid "Old and burned"
msgstr "옛 성벽과 불탄 자리"

msgid "Not every stretch starts bare — old courses still stand in places, and burned timbers must be pulled down before anything is built"
msgstr "모든 구간이 빈터에서 시작하는 것은 아닙니다. 곳곳에 옛 성벽이 남아 있고, 불탄 들보는 먼저 치워야 쌓을 수 있습니다"

msgid "The Broad Wall: raise the outer face, then the inner, then fill between — room for four at the work, and it takes half the blows"
msgstr "넓은 성벽: 바깥 면을 쌓고, 안쪽 면을 쌓은 뒤, 그 사이를 채우세요 — 네 명이 함께 일할 수 있고, 타격도 절반만 받습니다"

msgid "“The work is great and large.” Choose how the crew meets this stretch; each way has its price. The crew's pick decides; the host breaks a tie."
msgstr "“이 일은 크고 넓습니다.” 이번 구간을 어떻게 해 나갈지 고르세요. 어느 쪽이든 대가가 따릅니다. 다수결로 정하고, 동수이면 호스트가 정합니다."

msgid "Press the work"
msgstr "공사를 서두르기"

msgid "Hold the line"
msgstr "방어선 지키기"

msgid "Practised porters"
msgstr "숙련된 짐꾼"

msgid "Watch the market side"
msgstr "시장 쪽을 지키기"

msgid "Dig out the rubble"
msgstr "잔해 파내기"

msgid "Shore up the old courses"
msgstr "옛 성벽 보강하기"

msgid "Rush the faces"
msgstr "양면을 서둘러 쌓기"

msgid "Pack the core"
msgstr "속을 단단히 채우기"

msgid "Fire the ovens high"
msgstr "화덕을 세게 지피기"

msgid "Bank the ovens"
msgstr "화덕 불을 낮추기"

msgid "Work the terraces"
msgstr "계단식 밭에서 일하기"

msgid "Lookouts on the heights"
msgstr "높은 곳의 망꾼"

msgid "Carry in bundles"
msgstr "묶음으로 나르기"

msgid "Hold the road"
msgstr "길 지키기"

msgid "Building is %d%% quicker"
msgstr "건축이 %d%% 빨라집니다"

msgid "Building is %d%% slower"
msgstr "건축이 %d%% 느려집니다"

msgid "The wall takes %d%% more harm from blows"
msgstr "성벽이 타격에서 %d%% 더 큰 피해를 입습니다"

msgid "The wall takes %d%% less harm from blows"
msgstr "성벽이 타격에서 %d%% 적은 피해를 입습니다"

msgid "%d%% more foes"
msgstr "적이 %d%% 더 많아집니다"

msgid "%d%% fewer foes"
msgstr "적이 %d%% 줄어듭니다"

msgid "A beam dragged alone goes %d%% faster"
msgstr "혼자 끄는 들보가 %d%% 빨라집니다"

msgid "A beam dragged alone goes %d%% slower"
msgstr "혼자 끄는 들보가 %d%% 느려집니다"

msgid "Loaded workers walk %d%% faster"
msgstr "짐을 진 일꾼이 %d%% 빨리 걷습니다"

msgid "Loaded workers walk %d%% slower"
msgstr "짐을 진 일꾼이 %d%% 느리게 걷습니다"

msgid "Burned timbers come down %d%% faster"
msgstr "불탄 들보가 %d%% 빨리 치워집니다"

msgid "Burned timbers come down %d%% slower"
msgstr "불탄 들보가 %d%% 느리게 치워집니다"

msgid "Mortar takes %d%% more time to mix"
msgstr "회반죽을 섞는 데 %d%% 더 걸립니다"

msgid "Mortar takes %d%% less time to mix"
msgstr "회반죽을 섞는 데 %d%% 덜 걸립니다"

msgid "The watch posts stand from dawn, stocked with stone"
msgstr "망대가 새벽부터 서 있고 돌이 채워져 있습니다"

msgid "Sound the horn [horn] — a ring marks the spot"
msgstr "뿔나팔을 불면 [horn] 자리에 원이 표시돼요"

msgid "Sound the horn [%s] — a ring marks the spot"
msgstr "뿔나팔을 불면 [%s] 자리에 원이 표시돼요"

msgid "Gather in the ring: blows land harder there"
msgstr "원 안에 모이세요. 그 안에서는 공격이 더 강해져요"

msgid "Horn — rally the crew (stronger blows in its ring)"
msgstr "뿔나팔 — 일꾼을 모으기 (원 안에서 더 강한 공격)"

msgid "They come up the valley in surges — {horn} sounds the horn: gather in its ring and your blows land harder"
msgstr "적이 골짜기를 따라 파도처럼 몰려와요 — {horn} 키로 뿔나팔을 불고, 원 안에 모이면 공격이 더 강해져요"

msgid "[%s] Sound the horn — whoever stands in its ring strikes harder"
msgstr "[%s] 뿔나팔 불기 — 원 안에 선 사람은 더 강하게 공격해요"

msgid "RALLY — stronger blows here"
msgstr "집결 — 여기서는 공격이 더 강해요"

msgid "Rallied — your blows land harder here"
msgstr "집결! — 여기서는 공격이 더 강해요"

msgid "They'll slip in tonight — a watch on the wall!"
msgstr "오늘 밤 숨어들 거예요. 성벽에 파수꾼을 세우세요!"

msgid "But we made our prayer to our God, and set a watch against them day and night, because of them."
msgstr "그러나 우리는 우리 하느님께 기도하고, 그들 때문에 밤낮으로 파수꾼을 세웠다."

msgid "The watch held — they crept off in the dark."
msgstr "파수가 버텨 냈어요. 그들은 어둠 속으로 물러갔어요."

msgid "When our enemies heard that it was known to us, and God had brought their counsel to nothing, all of us returned to the wall, everyone to his work."
msgstr "원수들은 우리가 알아챘고 하느님께서 그들의 계획을 무너뜨리셨다는 소식을 듣자, 우리는 모두 성벽으로 돌아가 각자 자기 일을 했다."

msgid "The watch held in the night"
msgstr "밤사이 파수가 버텼다"

msgid "In the night they came — a stretch pulled down, the yard in rubble!"
msgstr "밤에 습격이 있었어요. 한 구간이 무너지고 마당은 잔해로 가득해요!"

msgid "The strength of the bearers of burdens is fading, and there is much rubble; so that we are not able to build the wall."
msgstr "짐꾼들의 힘이 빠지고 잔해가 많아서 우리는 성벽을 쌓을 수 없다."

msgid "Pulled down in the night"
msgstr "밤에 무너짐"

msgid "A fox! Tobiah said one would break our wall down…"
msgstr "여우다! 도비야가 여우 한 마리가 우리 성벽을 무너뜨릴 거라고 했는데…"

msgid "The hungry went back to their fields — we're short of hands."
msgstr "굶주린 이들이 밭으로 돌아갔어요. 일손이 모자라요."

msgid "Yet now our flesh is as the flesh of our brothers, our children as their children."
msgstr "그러나 우리 몸도 우리 형제들의 몸과 같고, 우리 자녀도 그들의 자녀와 같다."

msgid "Short of hands: the hungry were not fed"
msgstr "일손 부족: 굶주린 이들을 먹이지 못함"

msgid "A letter in the yard: they say you mean to be king!"
msgstr "마당에 편지가 돌아요. 당신이 왕이 되려 한다고 해요!"

msgid "You would be their king, according to these words."
msgstr "이 말대로라면 당신이 그들의 왕이 되려는 것이다."

msgid "A rumour weakens every hand"
msgstr "소문이 모두의 손을 약하게 함"

msgid "“No such things are done” — the letter is turned away."
msgstr "“그런 일은 없다.” 편지를 물리쳤어요."

msgid "There are no such things done as you say, but you imagine them out of your own heart."
msgstr "네가 말하는 그런 일은 없다. 네 마음에서 지어낸 것이다."

msgid "The letter answered"
msgstr "편지에 답함"

msgid "The rumour dies down — strengthen our hands!"
msgstr "소문이 잦아들어요. 우리 손을 굳세게 하소서!"

msgid "An open letter: “You would be their king”"
msgstr "공개 편지: “당신이 그들의 왕이 되려 한다”"

msgid "Reading the letter…"
msgstr "편지를 읽는 중…"

msgid "A man of the temple is asking for you — it's a trap!"
msgstr "성전의 한 사람이 당신을 찾아요. 함정이에요!"

msgid "Let us meet together in God’s house, within the temple, and let us shut the doors of the temple."
msgstr "하느님의 집 성전 안에서 만나 성전 문을 닫아걸자."

msgid "He turned away. He was hired to frighten us."
msgstr "그는 돌아갔어요. 우리를 겁주려고 고용된 사람이에요."

msgid "Should a man like me flee? Who is there that, being such as I, would go into the temple to save his life? I will not go in."
msgstr "나 같은 사람이 도망가겠느냐? 나 같은 자가 목숨을 구하려고 성전에 들어가겠느냐? 나는 들어가지 않겠다."

msgid "Would not hide in the temple"
msgstr "성전에 숨지 않음"

msgid "Someone has gone to hide in the temple!"
msgstr "누군가 성전에 숨으러 갔어요!"

msgid "He hired so that I would be afraid, do so, and sin."
msgstr "그는 내가 두려워하여 그렇게 하고 죄를 짓도록 고용된 것이다."

msgid "One hid in the temple"
msgstr "한 사람이 성전에 숨음"

msgid "Hide in the temple — they come tonight to kill you"
msgstr "성전에 숨으세요. 오늘 밤 당신을 죽이러 와요"

msgid "Going to hide in the temple…"
msgstr "성전으로 숨으러 가는 중…"

msgid "Should a man like me flee? Back to the wall!"
msgstr "나 같은 사람이 도망가겠는가? 성벽으로 돌아가자!"

msgid "Graphics"
msgstr "그래픽"

msgid "3D resolution"
msgstr "3D 해상도"

msgid "Low"
msgstr "낮음"

msgid "Medium"
msgstr "보통"

msgid "High"
msgstr "높음"

msgid "Window size"
msgstr "창 크기"

msgid "Default"
msgstr "기본값"

msgid "Art style"
msgstr "아트 스타일"

msgid "Lithograph"
msgstr "석판화"

msgid "Cel"
msgstr "셀 셰이딩"

msgid "Hold on — I'm coming!"
msgstr "버텨요, 지금 가요!"

msgid "I've got your back!"
msgstr "내가 지켜 줄게요!"

msgid "A thief in the yard!"
msgstr "마당에 도둑이다!"

msgid "I'll take the other end."
msgstr "반대쪽은 내가 들게요."

msgid "Foes at the wall!"
msgstr "적이 성벽에 왔다!"

msgid "I've fallen — help me up!"
msgstr "쓰러졌어요, 일으켜 줘요!"

msgid "Thank you, friend!"
msgstr "고마워요, 친구!"

msgid "Answer him"
msgstr "대답하기"

msgid "Hear him"
msgstr "들어 보기"

msgid "Go with him"
msgstr "따라가기"

msgid "From the villages: “Wherever you turn, they will attack us”"
msgstr "마을에서 온 사람: “어디로 돌아서든 그들이 우리를 칠 것이오”"

msgid "Shemaiah, shut in at home: “Let us meet together in God's house”"
msgstr "집에 틀어박힌 스마야: “하나님의 집에서 함께 만납시다”"

msgid "I am doing a great work — I can't come down!"
msgstr "나는 큰 일을 하고 있으니 내려갈 수 없소!"

msgid "No such things are done as you say!"
msgstr "네가 말한 그런 일은 없다!"

msgid "He points to where they'll come — watch there!"
msgstr "그가 적이 올 곳을 가리킨다. 그곳을 지켜라!"

msgid "All quiet on the road for now"
msgstr "지금은 길이 조용하다"

msgid "Hide in the temple? {interact} go with him, or walk on"
msgstr "성전에 숨을까? {interact} 따라가기, 아니면 그냥 지나가기"

msgid "He talks and talks — your work goes slower. {interact} to answer him"
msgstr "그가 계속 말을 건다. 일이 느려진다. {interact} 대답하기"

msgid "Messengers will call you down to Ono — answer them and keep working"
msgstr "사자들이 오노로 내려오라 부를 것이다. 대답하고 일을 계속하라"
