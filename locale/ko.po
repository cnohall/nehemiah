msgstr "%s 참가 중…"

msgid "Enter an address or lobby code first."
msgstr "먼저 주소나 로비 코드를 입력하세요."

msgid "Connecting…"
msgstr "연결 중…"

msgid "That's a Steam lobby code — start Steam first."
msgstr "Steam 로비 코드입니다 — 먼저 Steam을 실행하세요."

msgid "Connection failed. Check the address and that the host is running."
msgstr "연결에 실패했습니다. 주소와 호스트가 실행 중인지 확인하세요."

msgid "Could not open port %d."
msgstr "포트 %d을(를) 열 수 없습니다."

