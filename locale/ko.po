msgid "Come down to the plain of Ono"
msgstr "오노 평지로 내려오라"

msgid "Let go of the beam"
msgstr "들보를 놓았습니다"

msgid "Holding the other end — {interact} to let go"
msgstr "반대쪽 끝을 드는 중 — {interact} 놓기"

msgid "Stage built!"
msgstr "단계 완성!"

msgid "Hands full — deliver it, or {drop} to drop"
msgstr "손이 가득 참 — 전달하거나 {drop} 내려놓기"

msgid "Bring it to a wall"
msgstr "성벽으로 가져가세요"

msgid "Needs {need} first"
msgstr "먼저 필요: {need}"

msgid "Build this stage first — {drop} to drop, then {interact} to work"
msgstr "이 단계를 먼저 쌓으세요 — {drop} 내려놓고 {interact} 작업"

msgid "This wall is finished"
msgstr "이 성벽은 완성되었습니다"

msgid "Caught it"
msgstr "받았다"

msgid "Heavy — a partner can take the other end {interact}"
msgstr "무거움 — 동료가 반대쪽 끝을 들 수 있습니다 {interact}"

msgid "Enough hands here"
msgstr "여기는 일손이 충분합니다"

msgid "The horn was just sounded"
msgstr "방금 뿔나팔을 불었습니다"

msgid "Going down to Ono…"
msgstr "오노로 내려가는 중…"

msgid "Why should the work stop? Back to the wall!"
msgstr "어찌 공사를 멈추겠습니까? 성벽으로 돌아가자!"

msgid "Begin now"
msgstr "지금 시작"

