msgstr "%d:%02d / %d:%02d"

msgid "all through the section"
msgstr "구간 전체에서"

msgid "%d%% sound"
msgstr "%d%% 견고"

msgid "In good time"
msgstr "제때 완공"

msgid "None got through"
msgstr "침입 없음"

msgid "The wall holds"
msgstr "성벽이 견고함"

msgid "You"
msgstr "나"

msgid "%d of %d builders here"
msgstr "건축가 %d/%d명 도착"

