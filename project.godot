; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Nehemiah: The Wall"
config/description="Co-op 2-4 player HD-2D isometric action-strategy, 445 BC Jerusalem"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://scenes/network_manager/network_manager.gd"
GameState="*res://scenes/game_state/game_state.gd"
Sfx="*res://scenes/sfx/sfx.gd"
Settings="*res://scenes/settings/settings.gd"
InputMode="*res://scenes/input_mode/input_mode.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Nehemiah- The Wall"

[gui]

theme/custom="res://assets/ui/theme.tres"

